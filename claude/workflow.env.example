# .claude/workflow.env.example — 工作流单机/项目级配置的**模板**(此文件 track 进 git)。
# 用法:新机 clone 后 `cp .claude/workflow.env.example .claude/workflow.env`,按本机技术栈/模型填。
#   实机的 .claude/workflow.env 被 gitignore(每机不同,不进版本库);只本模板入库。
# 换项目 / 换模型只动 workflow.env 这一处;scripts source 它取默认值,skill 命令示例以它为准。
# 见 AGENTS.md「项目工具约定」。

# —— 命令(按项目技术栈填) ——
WF_TEST_CMD="uv run pytest"          # 跑测试
WF_PY="uv run python"                # 跑仓内 python 工具(check_docs 等)

# —— 派单模型分档(便宜劳力;「后端/模型」,后端 cursor|codex,省前缀=cursor) ——
# 换型号/换厂只改这里;run_worker.sh 读这三个做默认值,别在脚本/skill 里写死型号。
# 硬约束:验收员与 worker **模型家族要异构**(否则同源盲区)。
#   注意「cursor/」「codex/」是**派单 CLI 后端**,不等于模型家族——下例三档正好三家互异:
#   worker=composer(Cursor 家) · 默认验收=deepseek(DeepSeek 家) · 强审=gpt-5.6-luna(GPT 家)。
WF_WORKER_MODEL="cursor/composer-2.5"          # 默认执行(量大最省,别用 -fast)
WF_REVIEW_MODEL="codex/deepseek-v4-flash"      # 默认验收(异构 worker,真独立第二双眼)
WF_REVIEW_MODEL_STRONG="cursor/gpt-5.6-luna"   # 高危双验收的第二审 / 硬骨头(GPT 家,与 composer/deepseek 均异构)
