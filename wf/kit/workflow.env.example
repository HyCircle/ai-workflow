# .workflow/workflow.env —— 本机 / 项目级配置(本地忽略,不进 git)。wf init 首次安装时从本模板生成。
# 换项目 / 换模型只动这一处;wf 命令读取它。格式:KEY="值",# 开头为注释。

# 跑测试的命令(wf run --review / wf review 使用;留空则不跑)
WF_TEST_CMD="uv run pytest"

# 派单模型分档:「后端/模型」,后端 cursor|codex|claude,省前缀 = cursor。
# wf 命令里用 worker / review / strong 指代这三档。独立审查选择与 worker 不同的模型家族;
# 后端不等于模型家族——下例三档正好三家互异。
WF_WORKER_MODEL="cursor/composer-2.5"              # 默认执行(量大最省)
WF_REVIEW_MODEL="cursor/cursor-grok-4.6-high"      # 独立审查默认档(Grok 家)
WF_REVIEW_MODEL_STRONG="codex/gpt-5.6-terra"       # 更强判断 / 第二审(GPT 家)
# Claude Code 后端示例:claude/claude-sonnet-5-5
